# 7.  SENSITIVITY ANALYSIS  (Section 4.4 of paper)
#     Vary HSI and wind weights by ±5 % as in the paper
# ─────────────────────────────────────────────────

def sensitivity_analysis(scored_layers, eez_mask, mask_mpa, mask_ferry,
                          base_weights=WEIGHTS):
    """
    Run 4 alternative weighting scenarios (Table in Fig. 5 of paper):
        HSI-high, HSI-low, Wind-high, Wind-low
    Returns dict of scenario_name -> feasibility array.
    """
    def rescale(w_base, param, delta):
        w = dict(w_base)
        w[param] += delta
        # Redistribute remainder proportionally among other params
        others = {k: v for k, v in w.items() if k != param}
        scale  = (1 - w[param]) / sum(others.values())
        for k in others:
            w[k] = others[k] * scale
        return w

    scenarios = {
        "HSI-high" : rescale(base_weights, "hsi",        +0.05),
        "HSI-low"  : rescale(base_weights, "hsi",        -0.05),
        "Wind-high": rescale(base_weights, "wind_speed",  +0.05),
        "Wind-low" : rescale(base_weights, "wind_speed",  -0.05),
    }

    results = {}
    for name, w in scenarios.items():
        F = (
            w["hsi"]               * scored_layers["hsi"]      +
            w["wind_speed"]        * scored_layers["wind"]      +
            w["bathymetry"]        * scored_layers["bathy"]     +
            w["current_speed"]     * scored_layers["current"]   +
            w["distance_to_shore"] * scored_layers["dist"]      +
            w["water_level"]       * scored_layers["wlv"]       +
            w["fishing"]           * scored_layers["fishing"]
        ) * mask_mpa * mask_ferry * eez_mask
        results[name] = np.where(eez_mask == 0, np.nan, F)
        cell_area_km2 = (RESOLUTION / 1000)**2
        area_07 = np.nansum(results[name] >= 0.7) * cell_area_km2
        print(f"  {name:<12}  area ≥0.7 = {area_07:,.0f} km²")

    return results


